{
  "name": "vite-plugin-cli-browser-bridge",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "description": "A Vite plugin that allows an AI coding assistant to run commands on browser pages",
  "keywords": [
    "vite",
    "plugin",
    "ai",
    "llm",
    "browser",
    "command",
    "websocket"
  ],
  "homepage": "https://github.com/HexaField/vite-plugin-cli-browser-bridge",
  "bugs": {
    "url": "https://github.com/HexaField/vite-plugin-cli-browser-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HexaField/vite-plugin-cli-browser-bridge.git"
  },
  "license": "MIT",
  "author": "HexaField",
  "scripts": {
    "command": "ts-node --esm cli.ts",
    "typecheck": "tsc --noEmit",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:plugin:esm": "tsc -p tsconfig.json --outDir dist/esm --module NodeNext --moduleResolution NodeNext",
    "build:plugin:cjs": "tsc -p tsconfig.json --outDir dist/cjs --module CommonJS --moduleResolution Node && mv dist/cjs/vite-plugin-cli-browser-bridge.js dist/cjs/vite-plugin-cli-browser-bridge.cjs",
    "build:plugin": "npm run build:plugin:esm && npm run build:plugin:cjs",
    "build:all": "rm -rf ./dist && npm run build:plugin && npm run build:cli",
    "test:build": "node tests/test-build-mode.js",
    "test:cjs": "node tests/test-cjs-import.cjs",
    "test:esm": "node --experimental-vm-modules tests/test-esm-import.js",
    "test": "npm run build:all && npm run test:build && npm run test:cjs && npm run test:esm",
    "prepublishOnly": "npm run build:all && npm run test"
  },
  "main": "./dist/cjs/vite-plugin-cli-browser-bridge.cjs",
  "module": "./dist/esm/vite-plugin-cli-browser-bridge.js",
  "types": "./dist/esm/vite-plugin-cli-browser-bridge.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/vite-plugin-cli-browser-bridge.js",
      "require": "./dist/cjs/vite-plugin-cli-browser-bridge.cjs",
      "types": "./dist/esm/vite-plugin-cli-browser-bridge.d.ts"
    }
  },
  "bin": {
    "cli-browser-bridge": "./dist/cli.js",
    "cli-browser": "./npx-cli-browser-bridge.js"
  },
  "files": [
    "dist",
    "npx-cli-browser-bridge.js",
    "README.md",
    "CONTRIBUTING.md",
    "AGENT_HINTS.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "open": "^10.1.1",
    "uuid": "^9.0.1",
    "ws": "^8.18.1"
  }
}
